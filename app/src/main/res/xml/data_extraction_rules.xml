<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include preferences and local database for seamless user data retention -->
        <include domain="database" path="aura_focus_database.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="aura_focus_database.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
